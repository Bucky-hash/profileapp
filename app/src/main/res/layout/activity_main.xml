<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <ImageView
        android:id="@+id/imgAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:src="@android:drawable/sym_def_app_icon" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Chạm vào ảnh để đổi avatar" android:textSize="12sp" />

    <TextView android:id="@+id/tvName" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textSize="18sp" />
    <TextView android:id="@+id/tvMssv" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="18sp" />
    <TextView android:id="@+id/tvClass" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="18sp" />
    <TextView android:id="@+id/tvEmail" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="18sp" />

    <Button android:id="@+id/btnEdit" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="Chỉnh sửa thông tin" />
</LinearLayout>